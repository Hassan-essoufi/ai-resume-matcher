
# --- Docker image (CD pushes to GitHub Container Registry) ---
IMAGE=ghcr.io/hassan-essoufi/resume-matcher:latest

# --- OpenAI ---
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Secrets: generate each with `openssl rand -hex 24` ---
API_KEY=change-me
REDIS_PASSWORD=change-me
QDRANT_API_KEY=change-me

# --- Cache ---
CACHE_TTL_DAYS=30

# --- Scoring weights (sum = 1) ---
W_SEMANTIC=0.35
W_REQUIRED=0.40
W_NICE=0.10
W_EXPERIENCE=0.15
